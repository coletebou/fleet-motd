# ~/.config/motd/env — read by the collector only. KEY=value lines; parsed, never
# executed. Keep it chmod 600. A source whose keys are missing is skipped.
# CF_EMAIL=you@example.com
# CF_GLOBAL_API_KEY=
# CF_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# VERCEL_TOKEN=
# UPTIMEROBOT_API_KEY=
# PROBE_UPTIMEROBOT_IGNORE=old-monitor,staging   # monitor-name substrings to leave out
# HCLOUD_TOKEN=
# SENTRY_AUTH_TOKEN=
# STRIPE_SECRET_KEY=            # a restricted, read-only key
# RESEND_API_KEY=              # send-only; RESEND_FULL_API_KEY lets it read domains and sends
# RESEND_FULL_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# PROBE_GH_USER=octocat
# PROBE_GH_REPOS=octocat/hello,octocat/world
# PROBE_GH_BRANCH=main
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# NTFY_TOPIC=pick-a-long-random-topic-name
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# GITEA_TOKEN=
# BITBUCKET_TOKEN=               # or BITBUCKET_USER + BITBUCKET_APP_PASSWORD
